{
  "name": "petrus",
  "version": "0.4.1-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "tsc --noEmit -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "lint": "eslint app/src && tsc --noEmit -p app/tsconfig.json",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --debug --bundles app",
    "test:engine": ".venv/bin/python -m pytest engine/tests -q"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "cytoscape": "^3.30.0",
    "i18next": "^26.4.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
